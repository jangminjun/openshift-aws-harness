# Non-secret defaults for the OpenShift-on-AWS harness.
# Override any of these by exporting the same name before invoking harness.sh,
# e.g.  CLUSTER_NAME=demo2 AWS_REGION=us-west-2 ./harness.sh bastion-up

CLUSTER_NAME="${CLUSTER_NAME:-myocp}"
AWS_REGION="${AWS_REGION:-us-east-1}"
AWS_PROFILE="${AWS_PROFILE:-}"  # local named profile to read/forward creds from; empty = default chain
BASE_DOMAIN="${BASE_DOMAIN:-sandbox2471.opentlc.com}"

# Bastion (jump host) sizing / network
BASTION_INSTANCE_TYPE="${BASTION_INSTANCE_TYPE:-t3.large}"
# Resolved via `ec2 describe-images` (not the /aws/service/... SSM public
# parameter namespace) since some locked-down sandbox accounts block SSM
# access to AWS-owned public parameters.
BASTION_AMI_NAME_FILTER="${BASTION_AMI_NAME_FILTER:-al2023-ami-2023.*-kernel-*-x86_64}"
SSH_CIDR="${SSH_CIDR:-0.0.0.0/0}"
VPC_CIDR="${VPC_CIDR:-10.100.0.0/24}"
SUBNET_CIDR="${SUBNET_CIDR:-10.100.0.0/26}"
AVAILABILITY_ZONE="${AVAILABILITY_ZONE:-us-east-1a}"

# OpenShift cluster sizing (self-managed IPI)
# m5.xlarge (4 vCPU) masters looked fine at install time but consistently
# hit 80%+ CPU once RHOAI 3.4 + MaaS (Kuadrant/Istio) + GPU operator +
# multiple Data Science Pipelines Applications were all running together --
# API server request timeouts, clusteroperators (authentication/olm/
# machine-config) going Degraded, and the DSPA's Argo workflow-controller
# crash-looping on leader-election lease renewal (every KFP pipeline run
# adds real, sustained control-plane load: DSPA's own MariaDB/MinIO/
# multiple controllers, plus watches on every task pod). Same class of
# problem as the WORKER_TYPE note below, just for masters -- fixed live via
# ControlPlaneMachineSet resize to m5.2xlarge. See
# ../../basic-demo/lessonlearn.md #26/#27 for the full story.
MASTER_TYPE="${MASTER_TYPE:-m5.2xlarge}"
MASTER_REPLICAS="${MASTER_REPLICAS:-3}"
# m5.xlarge (4 vCPU, ~3.5 allocatable) is too small once RHOAI 3.4's full
# MaaS stack is on the cluster: RHCL/Kuadrant/Authorino/Limitador, Service
# Mesh 3 (Istio), the full DataScienceCluster (dashboard/workbenches/kserve/
# modelregistry/trustyai/feastoperator/llamastackoperator/mlflowoperator),
# MLflow, PostgreSQL, and the observability stack (COO/Perses/Grafana) all
# land on these same workers. In particular rhods-dashboard alone requests
# ~3.15 CPU across its 9 containers (model-registry-ui/gen-ai-ui/maas-ui/
# mlflow-ui/eval-hub-ui/automl-ui/autorag-ui, etc.) -- that alone barely fits
# on an m5.xlarge with nothing else scheduled, so it goes permanently Pending
# once anything else is running (a request-bin-packing problem, NOT a real
# capacity shortage -- `oc adm top nodes` looks fine even while pods are
# Pending; check `oc describe node` request % instead). Adding more small
# workers doesn't fix it, only bigger ones do. m5.2xlarge (8 vCPU, ~7.5
# allocatable) x4 was what it took to run everything below without any pod
# stuck Pending. See ../../basic-demo/lessonlearn.md #11/#12 for the full story.
WORKER_TYPE="${WORKER_TYPE:-m5.2xlarge}"
WORKER_REPLICAS="${WORKER_REPLICAS:-4}"

# OpenShift AI GPU worker MachineSet (run gpu-machineset repeatedly with a
# different GPU_INSTANCE_TYPE to add more GPU flavors side by side)
GPU_INSTANCE_TYPE="${GPU_INSTANCE_TYPE:-g5.2xlarge}"
GPU_REPLICAS="${GPU_REPLICAS:-1}"
GPU_MACHINESET_AZ="${GPU_MACHINESET_AZ:-us-east-1a}"  # must offer GPU_INSTANCE_TYPE
# gpu-machineset wires up a MachineAutoscaler for every GPU flavor it creates
# (and the cluster-wide ClusterAutoscaler singleton, once) using these bounds.
GPU_MIN_REPLICAS="${GPU_MIN_REPLICAS:-1}"
GPU_MAX_REPLICAS="${GPU_MAX_REPLICAS:-2}"
MAX_NODES_TOTAL="${MAX_NODES_TOTAL:-20}"

# AWS Neuron (Inferentia2/Trainium) NPU worker MachineSet
NEURON_INSTANCE_TYPE="${NEURON_INSTANCE_TYPE:-inf2.xlarge}"
NEURON_REPLICAS="${NEURON_REPLICAS:-1}"
NEURON_MACHINESET_AZ="${NEURON_MACHINESET_AZ:-us-east-1a}"  # must offer NEURON_INSTANCE_TYPE

# Local paths
PULL_SECRET_FILE="${PULL_SECRET_FILE:-$HOME/.openshift/pull-secret.json}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/${CLUSTER_NAME}-bastion}"

# GPU monitoring / demo control-plane (scenario doc: openshift-monitoring)
MONITORING_NAMESPACE="${MONITORING_NAMESPACE:-gpu-monitoring}"
GPU_TEMP_THRESHOLD_C="${GPU_TEMP_THRESHOLD_C:-70}"  # g5/g6 (A10G/L4) plateau around 82C under sustained load, never hit 85
SLACK_WEBHOOK_URL="${SLACK_WEBHOOK_URL:-}"   # https://hooks.slack.com/services/... — leave empty to wire structure without sending
SLACK_CHANNEL="${SLACK_CHANNEL:-#alarm-gpu-monitoring}"

# HTPasswd cluster-admin user — no default password, must be set explicitly:
#   ADMIN_PASSWORD='...' ./harness.sh create-admin-user
ADMIN_USERNAME="${ADMIN_USERNAME:-admin}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:?set ADMIN_PASSWORD}"

# RHOAI operator channel. "stable" tracks whatever the catalog currently
# pins it to (was RHOAI 2.25.8 as of 2026-09) -- pin an explicit versioned
# channel to actually get 3.4 with MaaS (Models-as-a-Service) support.
RHOAI_CHANNEL="${RHOAI_CHANNEL:-stable-3.4}"

# MaaS (Models-as-a-Service: RHCL/Kuadrant auth+rate-limiting, Gateway API,
# PostgreSQL-backed subscriptions/API keys) is configured by RHOAI-Toolkit's
# install-rhoai-34.sh rather than reimplemented here -- it's a large,
# actively-maintained installer (Kuadrant/Istio/Service-Mesh-3 dance,
# service-ca TLS, Redis-backed rate limiting, ...) not worth forking.
# `maas` clones/updates it on the bastion and runs it against the cluster
# harness.sh already built. Pin a ref for reproducibility if needed:
#   MAAS_TOOLKIT_REF=<tag-or-commit> ./harness.sh maas
MAAS_TOOLKIT_REPO="${MAAS_TOOLKIT_REPO:-https://github.com/hyogrin/RHOAI-Toolkit.git}"
MAAS_TOOLKIT_REF="${MAAS_TOOLKIT_REF:-}"  # empty = default branch
